# Copiá a .env en esta carpeta (apps/patient-mobile). Expo carga EXPO_PUBLIC_* al bundlear.

# URL del API (sin barra final).
# — Simulador iOS con API en la Mac: http://localhost:4000
# — Emulador Android: http://10.0.2.2:4000
# — Teléfono físico (misma Wi‑Fi): http://TU_IP_LAN:4000  (ej. http://192.168.1.42:4000)
# Producción (TestFlight / APK): por defecto https://api.motivarcare.com (app.json extra.apiUrl).
# Override local o staging:
# EXPO_PUBLIC_API_URL=https://api.motivarcare.com

# Deep links (scheme motivarcare://):
#   motivarcare://verify-email?token=…
#   motivarcare://reset-password?token=…
# Bundle IDs: com.motivarcare.patient (iOS + Android)

# EAS (Ola 5): después de `eas init`, pegá el projectId en app.json → extra.eas.projectId
# Builds internos: npm run eas:ios:preview | eas:android:preview
# Checklist: STORE_CHECKLIST.md

# Si el teléfono no alcanza el bundler Metro, probá la IP de tu Mac (misma red):
# REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.42
